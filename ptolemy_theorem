import React, { useState, useEffect, useRef, useCallback } from 'react';

// Helper function to calculate distance between two points
const getDistance = (p1, p2) => {
return Math.sqrt(Math.pow(p2.x - p1.x, 2) + Math.pow(p2.y - p1.y, 2));
};

// Helper function to convert angle to point on circle
const angleToPoint = (angle, radius, center) => {
return {
x: center.x + radius * Math.cos(angle),
y: center.y + radius * Math.sin(angle)
};
};

// Format numbers cleanly
const formatNum = (num) => Number(num).toFixed(3);

const App = () => {
// SVG Canvas dimensions
const width = 600;
const height = 600;
const center = { x: width / 2, y: height / 2 };
const radius = 220;

// App Modes: 'proof', 'sine-sum', 'cosine-sum'
const [mode, setMode] = useState('sine-sum');

// Note on Angles in SVG (Y goes down):
// 0 = Right, PI/2 = Bottom, PI = Left, 3*PI/2 = Top.
// Clockwise order A -> B -> C -> D means angles should increase.
const defaultAngles = {
proof: { A: 11 * Math.PI / 6, B: Math.PI / 4, C: 3 * Math.PI / 4, D: 4 * Math.PI / 3 },
'sine-sum': { A: Math.PI, B: 4.2, C: 0, D: 1.2 }, // B on top, D on bottom
'cosine-sum': { A: Math.PI, B: 4.0, C: 5.2, D: 0 } // B, C on top
};

const [angles, setAngles] = useState(defaultAngles['sine-sum']);
const [activePoint, setActivePoint] = useState(null);
const [proofStep, setProofStep] = useState(0);

const [rectAlpha, setRectAlpha] = useState(35);
const [rectBeta, setRectBeta] = useState(25);
const svgRef = useRef(null);

// Handle mode switching
const handleModeChange = (newMode) => {
setMode(newMode);
if (newMode !== 'rect-proof') {
setAngles(defaultAngles[newMode]);
}
setProofStep(0);
setActivePoint(null);
};

const handlePointerDown = (e, pointName) => {
e.preventDefault();
if (mode === 'sine-sum' && (pointName === 'A' || pointName === 'C')) return; // Fixed diameter
if (mode === 'cosine-sum' && (pointName === 'A' || pointName === 'D')) return; // Fixed diameter
setActivePoint(pointName);
};

const handlePointerMove = useCallback((e) => {
if (!activePoint || !svgRef.current) return;

const clientX = e.touches ? e.touches[0].clientX : e.clientX;
const clientY = e.touches ? e.touches[0].clientY : e.clientY;
const svgRect = svgRef.current.getBoundingClientRect();
const x = clientX - svgRect.left;
const y = clientY - svgRect.top;

let newAngle = Math.atan2(y - center.y, x - center.x);
if (newAngle < 0) newAngle +=2 * Math.PI; const buffer=0.15; setAngles(prev=> {
    let valid = false;

    if (mode === 'proof') {
    let prevPoint, nextPoint;
    if (activePoint === 'A') { prevPoint = 'D'; nextPoint = 'B'; }
    if (activePoint === 'B') { prevPoint = 'A'; nextPoint = 'C'; }
    if (activePoint === 'C') { prevPoint = 'B'; nextPoint = 'D'; }
    if (activePoint === 'D') { prevPoint = 'C'; nextPoint = 'A'; }

    let prevAngle = prev[prevPoint];
    let nextAngle = prev[nextPoint];
    while (prevAngle > nextAngle) nextAngle += 2 * Math.PI;
    let targetAngle = newAngle;
    while (targetAngle < prevAngle) targetAngle +=2 * Math.PI; if (targetAngle> prevAngle + buffer && targetAngle <
            nextAngle - buffer) valid=true; } else if (mode==='sine-sum' ) { // B must be top (PI to 2PI), D must be
            bottom (0 to PI) if (activePoint==='B' && newAngle> Math.PI + buffer && newAngle < 2 * Math.PI - buffer)
                valid=true; if (activePoint==='D' && newAngle> buffer && newAngle < Math.PI - buffer) valid=true; } else
                    if (mode==='cosine-sum' ) { // B and C on top (PI to 2PI), B must be left of C (so angle B < angle
                    C) if (activePoint==='B' && newAngle> Math.PI + buffer && newAngle < prev.C - buffer) valid=true; if
                        (activePoint==='C' && newAngle> prev.B + buffer && newAngle < 2 * Math.PI - buffer) valid=true;
                            } return valid ? { ...prev, [activePoint]: newAngle } : prev; }); }, [activePoint, mode,
                            center]); const handlePointerUp=useCallback(()=> setActivePoint(null), []);

                            useEffect(() => {
                            if (activePoint) {
                            window.addEventListener('mousemove', handlePointerMove);
                            window.addEventListener('mouseup', handlePointerUp);
                            window.addEventListener('touchmove', handlePointerMove, { passive: false });
                            window.addEventListener('touchend', handlePointerUp);
                            }
                            return () => {
                            window.removeEventListener('mousemove', handlePointerMove);
                            window.removeEventListener('mouseup', handlePointerUp);
                            window.removeEventListener('touchmove', handlePointerMove);
                            window.removeEventListener('touchend', handlePointerUp);
                            };
                            }, [activePoint, handlePointerMove, handlePointerUp]);

                            // Calculate point coordinates for the circular modes
                            const points = {
                            A: angleToPoint(angles.A, radius, center),
                            B: angleToPoint(angles.B, radius, center),
                            C: angleToPoint(angles.C, radius, center),
                            D: angleToPoint(angles.D, radius, center)
                            };

                            const AB = getDistance(points.A, points.B);
                            const BC = getDistance(points.B, points.C);
                            const CD = getDistance(points.C, points.D);
                            const DA = getDistance(points.D, points.A);
                            const AC = getDistance(points.A, points.C);
                            const BD = getDistance(points.B, points.D);

                            // Scale for display values when a diagonal/side is set to 1
                            const scale = mode === 'sine-sum' ? 1 / AC : (mode === 'cosine-sum' ? 1 / DA : 1);

                            // Construct Point E for Proof Mode
                            let E = { x: 0, y: 0 };
                            if (mode === 'proof') {
                            const ratio = (AB * CD) / BD; // AE = (AB * CD) / BD based on similarity
                            const acLen = getDistance(points.A, points.C);
                            // Interpolate E along AC
                            E = {
                            x: points.A.x + (points.C.x - points.A.x) * (ratio / acLen),
                            y: points.A.y + (points.C.y - points.A.y) * (ratio / acLen)
                            };
                            }

                            // Calculate trig angles for visualization arcs
                            let alpha = 0;
                            let beta = 0;
                            if (mode === 'sine-sum') {
                            // A=PI, C=0. B top, D bottom.
                            // alpha = angle BAC. Arc BC = 2*PI - angles.B.
                            alpha = (2 * Math.PI - angles.B) / 2;
                            // beta = angle CAD. Arc CD = angles.D - 0.
                            beta = angles.D / 2;
                            } else if (mode === 'cosine-sum') {
                            // A=PI, D=0. B, C on top.
                            // beta = angle CAD. Arc CD = 2*PI - angles.C.
                            beta = (2 * Math.PI - angles.C) / 2;
                            // alpha from (90 - alpha) = angle BAD. Arc BD = 2*PI - angles.B.
                            let angleBAD = (2 * Math.PI - angles.B) / 2;
                            alpha = (Math.PI / 2) - angleBAD;
                            }

                            // Calculations for Rectangle Proof Mode
                            const alphaRad = (rectAlpha * Math.PI) / 180;
                            const betaRad = (rectBeta * Math.PI) / 180;

                            const rectScale = 380; // Length of main hypotenuse
                            const O = { x: center.x - 180, y: center.y + 180 };

                            const P1 = {
                            x: O.x + rectScale * Math.cos(alphaRad + betaRad),
                            y: O.y - rectScale * Math.sin(alphaRad + betaRad)
                            };

                            const P2 = {
                            x: O.x + rectScale * Math.cos(betaRad) * Math.cos(alphaRad),
                            y: O.y - rectScale * Math.cos(betaRad) * Math.sin(alphaRad)
                            };

                            const V_bl = { x: O.x, y: O.y };
                            const V_br = { x: P2.x, y: O.y };
                            const V_tl = { x: O.x, y: P1.y };
                            const V_tr = { x: P2.x, y: P1.y };

                            // Right Angle Helper Component
                            const RightAngle = ({ p, p1, p2, size = 15 }) => {
                            const angle1 = Math.atan2(p1.y - p.y, p1.x - p.x);
                            const angle2 = Math.atan2(p2.y - p.y, p2.x - p.x);
                            const d1 = { x: Math.cos(angle1) * size, y: Math.sin(angle1) * size };
                            const d2 = { x: Math.cos(angle2) * size, y: Math.sin(angle2) * size };
                            return (
                            <polyline points={`${p.x + d1.x},${p.y + d1.y} ${p.x + d1.x + d2.x},${p.y + d1.y + d2.y}
                                ${p.x + d2.x},${p.y + d2.y}`} fill="none" stroke="#94a3b8" strokeWidth="1.5" />
                            );
                            };

                            // Label Helper Component
                            const LabelLine = ({ p1, p2, text, color, offset = 20, bg = true }) => {
                            const cx = (p1.x + p2.x) / 2;
                            const cy = (p1.y + p2.y) / 2;
                            const dx = p2.x - p1.x;
                            const dy = p2.y - p1.y;
                            const len = Math.sqrt(dx * dx + dy * dy);
                            const nx = -dy / len;
                            const ny = dx / len;
                            return (
                            <g transform={`translate(${cx + nx * offset}, ${cy + ny * offset})`}>
                                {bg &&
                                <rect x="-30" y="-12" width="60" height="24" fill="#0f172a" opacity="0.7" rx="4" />}
                                <text textAnchor="middle" dominantBaseline="middle" fill={color} fontSize="14"
                                    fontWeight="600" className="pointer-events-none select-none">
                                    {text}
                                </text>
                            </g>
                            );
                            };

                            return (
                            <div
                                className="flex flex-col md:flex-row min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-indigo-500/30">

                                {/* Left Panel */}
                                <div
                                    className="w-full md:w-5/12 lg:w-[450px] border-b md:border-b-0 md:border-r border-slate-800 bg-slate-900/50 flex flex-col h-screen z-10">
                                    <div className="p-6 border-b border-slate-800">
                                        <h1 className="text-2xl font-bold tracking-tight text-white mb-4">Ptolemy's
                                            Theorem</h1>

                                        <div
                                            className="flex bg-slate-800/80 p-1 rounded-lg shadow-inner gap-1 flex-wrap">
                                            <button onClick={()=> handleModeChange('proof')} className={`flex-1
                                                min-w-[120px] text-xs sm:text-sm py-2 px-3 rounded-md transition-all
                                                font-medium ${mode === 'proof' ? 'bg-indigo-600 text-white shadow-md' :
                                                'text-slate-400 hover:text-slate-200 hover:bg-slate-700/50'}`}>General
                                                Proof</button>
                                            <button onClick={()=> handleModeChange('sine-sum')} className={`flex-1
                                                min-w-[120px] text-xs sm:text-sm py-2 px-3 rounded-md transition-all
                                                font-medium ${mode === 'sine-sum' ? 'bg-indigo-600 text-white shadow-md'
                                                : 'text-slate-400 hover:text-slate-200 hover:bg-slate-700/50'}`}>Ptolemy
                                                Sine</button>
                                            <button onClick={()=> handleModeChange('cosine-sum')} className={`flex-1
                                                min-w-[120px] text-xs sm:text-sm py-2 px-3 rounded-md transition-all
                                                font-medium ${mode === 'cosine-sum' ? 'bg-indigo-600 text-white
                                                shadow-md' : 'text-slate-400 hover:text-slate-200
                                                hover:bg-slate-700/50'}`}>Ptolemy Cosine</button>
                                            <button onClick={()=> handleModeChange('rect-proof')} className={`flex-1
                                                min-w-[120px] text-xs sm:text-sm py-2 px-3 rounded-md transition-all
                                                font-medium ${mode === 'rect-proof' ? 'bg-green-600 text-white
                                                shadow-md' : 'text-slate-400 hover:text-slate-200
                                                hover:bg-slate-700/50'}`}>Rectangle Proof</button>
                                        </div>
                                    </div>

                                    <div className="flex-1 overflow-y-auto p-6 space-y-6 custom-scrollbar">

                                        {}
                                        {mode === 'proof' && (
                                        <>
                                            <p className="text-slate-400 text-sm leading-relaxed">
                                                Drag any vertex around the circle. Ptolemy's Theorem proves that for any
                                                cyclic quadrilateral, the product of the diagonals equals the sum of the
                                                products of opposite sides.
                                            </p>
                                            <div
                                                className="bg-slate-950 rounded-xl p-4 border border-slate-800 shadow-inner">
                                                <div className="flex justify-between items-center mb-3">
                                                    <h2
                                                        className="text-sm font-semibold text-slate-300 uppercase tracking-wider">
                                                        Proof Steps</h2>
                                                    <span
                                                        className="text-xs font-mono bg-indigo-900/50 text-indigo-300 px-2 py-1 rounded">Step
                                                        {proofStep + 1}/7</span>
                                                </div>

                                                <div className="flex gap-2 mb-4">
                                                    <button onClick={()=> setProofStep(Math.max(0, proofStep - 1))}
                                                        disabled={proofStep === 0} className="flex-1 bg-slate-800
                                                        hover:bg-slate-700 disabled:opacity-50 text-sm py-2 rounded-md
                                                        transition-colors border border-slate-700">Prev</button>
                                                    <button onClick={()=> setProofStep(Math.min(6, proofStep + 1))}
                                                        disabled={proofStep === 6} className="flex-1 bg-indigo-600
                                                        hover:bg-indigo-500 disabled:opacity-50 text-sm py-2 rounded-md
                                                        transition-colors font-medium">Next</button>
                                                </div>
                                                <div
                                                    className="bg-slate-800/80 p-3 rounded-lg border border-slate-700 min-h-[80px]">
                                                    <h3 className="text-white font-medium mb-1">
                                                        {["Initial Setup", "Construct Point E", "First Similar
                                                        Triangles", "First Equation", "Second Similar Triangles",
                                                        "Second Equation", "Combine and Solve"][proofStep]}
                                                    </h3>
                                                    <p className="text-slate-400 text-sm leading-relaxed">
                                                        {[
                                                        "Start with cyclic quadrilateral ABCD. Draw diagonals AC and
                                                        BD.",
                                                        "Locate E on AC exactly such that ∠ABE = ∠DBC.",
                                                        "△ABE ~ △DBC because ∠ABE = ∠DBC (by construction) and ∠BAE =
                                                        ∠BDC (both subtend arc BC).",
                                                        "Since △ABE ~ △DBC, the ratio of sides is AB/BD = AE/CD.
                                                        Therefore: AB × CD = AE × BD.",
                                                        "△ABD ~ △EBC because ∠ABD = ∠EBC (both are ∠ABE + ∠EBD) and ∠BDA
                                                        = ∠BCE (subtend arc AB).",
                                                        "Since △ABD ~ △EBC, ratio is AD/EC = BD/BC. Therefore: AD × BC =
                                                        EC × BD.",
                                                        "Add equations: (AB × CD) + (AD × BC) = (AE × BD) + (EC × BD) =
                                                        BD × (AE + EC) = BD × AC."
                                                        ][proofStep]}
                                                    </p>
                                                </div>
                                            </div>
                                        </>
                                        )}

                                        {}
                                        {mode === 'sine-sum' && (
                                        <div className="space-y-4">
                                            <p className="text-slate-300 text-sm leading-relaxed">
                                                By setting the diagonal <strong>AC as the diameter</strong> (length 1),
                                                the sides of the quadrilateral become pure trigonometric functions of
                                                the angles α and β.
                                            </p>

                                            <div
                                                className="bg-slate-900 rounded-lg p-4 border border-slate-800 space-y-3 font-mono text-sm">
                                                <div className="flex justify-between"><span
                                                        className="text-slate-400">Diameter AC</span><span
                                                        className="text-white">1.0</span></div>
                                                <div className="flex justify-between"><span
                                                        className="text-yellow-400">AB =
                                                        cos(α)</span><span>{formatNum(AB*scale)}</span></div>
                                                <div className="flex justify-between"><span
                                                        className="text-green-400">BC =
                                                        sin(α)</span><span>{formatNum(BC*scale)}</span></div>
                                                <div className="flex justify-between"><span className="text-blue-400">AD
                                                        = cos(β)</span><span>{formatNum(DA*scale)}</span></div>
                                                <div className="flex justify-between"><span className="text-pink-400">CD
                                                        = sin(β)</span><span>{formatNum(CD*scale)}</span></div>
                                                <div className="flex justify-between border-t border-slate-700 pt-2">
                                                    <span className="text-purple-400 font-bold">BD =
                                                        sin(α+β)</span><span
                                                        className="font-bold">{formatNum(BD*scale)}</span>
                                                </div>
                                            </div>

                                            <div
                                                className="bg-indigo-950/40 rounded-lg p-4 border border-indigo-900/50">
                                                <h3
                                                    className="text-indigo-300 font-semibold mb-2 text-sm uppercase tracking-wider">
                                                    Ptolemy's Equation</h3>
                                                <p className="text-slate-300 font-mono text-sm mb-3">AC × BD = (AB × CD)
                                                    + (BC × AD)</p>
                                                <div
                                                    className="bg-slate-950 p-3 rounded border border-slate-800 text-center text-lg font-serif">
                                                    1 × <span className="text-purple-400">sin(α+β)</span> = <span
                                                        className="text-yellow-400">cos(α)</span><span
                                                        className="text-pink-400">sin(β)</span> + <span
                                                        className="text-green-400">sin(α)</span><span
                                                        className="text-blue-400">cos(β)</span>
                                                </div>
                                            </div>
                                        </div>
                                        )}

                                        {}
                                        {mode === 'cosine-sum' && (
                                        <div className="space-y-4">
                                            <p className="text-slate-300 text-sm leading-relaxed">
                                                By setting the side <strong>AD as the diameter</strong> (length 1), and
                                                carefully mapping the angles, we can geometrically prove the Cosine Sum
                                                Identity.
                                            </p>

                                            <div
                                                className="bg-slate-900 rounded-lg p-4 border border-slate-800 space-y-3 font-mono text-sm">
                                                <div className="flex justify-between"><span
                                                        className="text-slate-400">Diameter AD</span><span
                                                        className="text-white">1.0</span></div>
                                                <div className="flex justify-between"><span
                                                        className="text-yellow-400">AB =
                                                        sin(α)</span><span>{formatNum(AB*scale)}</span></div>
                                                <div className="flex justify-between"><span className="text-pink-400">CD
                                                        = sin(β)</span><span>{formatNum(CD*scale)}</span></div>
                                                <div className="flex justify-between"><span
                                                        className="text-purple-400">BD =
                                                        cos(α)</span><span>{formatNum(BD*scale)}</span></div>
                                                <div className="flex justify-between"><span className="text-blue-400">AC
                                                        = cos(β)</span><span>{formatNum(AC*scale)}</span></div>
                                                <div className="flex justify-between border-t border-slate-700 pt-2">
                                                    <span className="text-green-400 font-bold">BC = cos(α+β)</span><span
                                                        className="font-bold">{formatNum(BC*scale)}</span>
                                                </div>
                                            </div>

                                            <div
                                                className="bg-indigo-950/40 rounded-lg p-4 border border-indigo-900/50">
