                                            <div
                                                className="bg-indigo-950/40 rounded-lg p-4 border border-indigo-900/50 space-y-2 text-xs text-slate-300 font-sans">
                                                <h3 className="text-indigo-300 font-semibold text-xs uppercase tracking-wider">
                                                    Historical Reference</h3>
                                                <p className="leading-relaxed">
                                                    The specific geometric configuration shown in the image—where right triangles are stacked inside a bounding rectangle to visuals-test the angle sum identities—is widely popularized and famously compiled by mathematician Roger B. Nelsen in his book <a href="https://bookstore.ams.org/view?ProductCode=CLRM-PWW-SET#:~:text=Roger%20B.%20Nelsen%2C%20Proofs%20Without%20Words%2C%20Vols.,Imprint%20of%20the%20American%20Mathematical%20Society%2C%20Softcover" target="_blank" rel="noopener noreferrer" className="text-sky-400 hover:text-sky-300 underline font-semibold">Proofs Without Words</a>.
                                                </p>
                                                <p className="leading-relaxed">
                                                    See examples of such style on the <a href="https://artofproblemsolving.com/wiki/index.php/Proofs_without_words?srsltid=AfmBOoojee4hWvHp3OP3b0rjzjXNnay19Yt32Ma2YB1TeywTUzbZzP2O" target="_blank" rel="noopener noreferrer" className="text-sky-400 hover:text-sky-300 underline font-semibold">AoPS Wiki: Proofs Without Words</a> page.
                                                </p>
                                            </div>
                                        </div>
                                        )}
                                    </div>
                                </div>

                                {/* Right Panel Canvas Area */}
                                <div
                                    className="flex-1 flex items-center justify-center p-4 relative overflow-hidden bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-slate-800 to-slate-950">

                                    <div className="absolute inset-0 opacity-[0.03] pointer-events-none" style={{
                                        backgroundImage: 'linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px)'
                                        , backgroundSize: '40px 40px' }}></div>

                                    <svg ref={svgRef} width="100%" height="100%" viewBox={`0 0 ${width} ${height}`}
                                        className="max-w-2xl touch-none drop-shadow-2xl">
                                        {mode !== 'rect-proof' && (
                                        <circle cx={center.x} cy={center.y} r={radius} fill="none" stroke="#475569"
                                            strokeWidth="2" strokeDasharray="4 4" />
                                        )}

                                        {/* Diagonals & Diameter Basis */}
                                        {mode === 'proof' && (
                                        <>
                                            <line x1={points.A.x} y1={points.A.y} x2={points.C.x} y2={points.C.y}
                                                stroke="#64748b" strokeWidth="1.5" />
                                            <line x1={points.B.x} y1={points.B.y} x2={points.D.x} y2={points.D.y}
                                                stroke="#64748b" strokeWidth="1.5" />
                                        </>
                                        )}

                                        {mode === 'sine-sum' && (
                                        <>
                                            <line x1={points.A.x} y1={points.A.y} x2={points.C.x} y2={points.C.y}
                                                stroke="#cbd5e1" strokeWidth="3" opacity="0.8" />
                                            <line x1={points.B.x} y1={points.B.y} x2={points.D.x} y2={points.D.y}
                                                stroke="#c084fc" strokeWidth="3" />
                                            <LabelLine p1={points.B} p2={points.D} text="sin(α+β)" color="#c084fc"
                                                offset={-25} />
                                        </>
                                        )}

                                        {mode === 'cosine-sum' && (
                                        <>
                                            <line x1={points.A.x} y1={points.A.y} x2={points.D.x} y2={points.D.y}
                                                stroke="#cbd5e1" strokeWidth="3" opacity="0.8" />
                                            <line x1={points.B.x} y1={points.B.y} x2={points.D.x} y2={points.D.y}
                                                stroke="#c084fc" strokeWidth="3" strokeDasharray="6 4" />
                                            <line x1={points.A.x} y1={points.A.y} x2={points.C.x} y2={points.C.y}
                                                stroke="#60a5fa" strokeWidth="3" strokeDasharray="6 4" />
                                            <LabelLine p1={points.B} p2={points.D} text="cos(α)" color="#c084fc"
                                                offset={25} />
                                            <LabelLine p1={points.A} p2={points.C} text="cos(β)" color="#60a5fa"
                                                offset={-25} />
                                        </>
                                        )}

                                        {/* Quadrilateral Sides */}
                                        {mode === 'proof' && (
                                        <polygon points={`${points.A.x},${points.A.y} ${points.B.x},${points.B.y}
                                            ${points.C.x},${points.C.y} ${points.D.x},${points.D.y}`} fill="none"
                                            stroke="#fbbf24" strokeWidth="2" strokeLinejoin="round" />
                                        )}

                                        {mode === 'sine-sum' && (
                                        <>
                                            <line x1={points.A.x} y1={points.A.y} x2={points.B.x} y2={points.B.y}
                                                stroke="#facc15" strokeWidth="3" />
                                            <line x1={points.B.x} y1={points.B.y} x2={points.C.x} y2={points.C.y}
                                                stroke="#4ade80" strokeWidth="3" />
                                            <line x1={points.C.x} y1={points.C.y} x2={points.D.x} y2={points.D.y}
                                                stroke="#f472b6" strokeWidth="3" />
                                            <line x1={points.D.x} y1={points.D.y} x2={points.A.x} y2={points.A.y}
                                                stroke="#60a5fa" strokeWidth="3" />

                                            <LabelLine p1={points.A} p2={points.B} text="cos(α)" color="#facc15" />
                                            <LabelLine p1={points.B} p2={points.C} text="sin(α)" color="#4ade80" />
                                            <LabelLine p1={points.A} p2={points.D} text="cos(β)" color="#60a5fa" />
                                            <LabelLine p1={points.D} p2={points.C} text="sin(β)" color="#f472b6"
                                                offset={-25} />
                                        </>
                                        )}

                                        {mode === 'cosine-sum' && (
                                        <>
                                            <line x1={points.A.x} y1={points.A.y} x2={points.B.x} y2={points.B.y}
                                                stroke="#facc15" strokeWidth="3" />
                                            <line x1={points.B.x} y1={points.B.y} x2={points.C.x} y2={points.C.y}
                                                stroke="#4ade80" strokeWidth="3" />
                                            <line x1={points.C.x} y1={points.C.y} x2={points.D.x} y2={points.D.y}
                                                stroke="#f472b6" strokeWidth="3" />

                                            <LabelLine p1={points.A} p2={points.B} text="sin(α)" color="#facc15" />
                                            <LabelLine p1={points.B} p2={points.C} text="cos(α+β)" color="#4ade80" />
                                            <LabelLine p1={points.C} p2={points.D} text="sin(β)" color="#f472b6" />
                                        </>
                                        )}

                                        {/* Angle Arcs & Labels for Trig Modes */}
                                        {mode === 'sine-sum' && (
                                        <g>
                                            {/* Alpha Angle at A */}
                                            <path d={`M ${points.A.x + 40} ${points.A.y} A 40 40 0 0 1 ${points.A.x + 40
                                                * Math.cos(alpha)} ${points.A.y - 40 * Math.sin(alpha)}`} fill="none"
                                                stroke="#facc15" strokeWidth="2" opacity="0.6" />
                                            <text x={points.A.x + 55} y={points.A.y - 15} fill="#facc15" fontSize="14"
                                                fontWeight="bold">α</text>

                                            {/* Beta Angle at A */}
                                            <path d={`M ${points.A.x + 40} ${points.A.y} A 40 40 0 0 0 ${points.A.x + 40
                                                * Math.cos(-beta)} ${points.A.y - 40 * Math.sin(-beta)}`} fill="none"
                                                stroke="#60a5fa" strokeWidth="2" opacity="0.6" />
                                            <text x={points.A.x + 55} y={points.A.y + 15} fill="#60a5fa" fontSize="14"
                                                fontWeight="bold">β</text>
                                        </g>
                                        )}

                                        {mode === 'cosine-sum' && (
                                        <g>
                                            {/* 90-Alpha Angle at A */}
                                            <path d={`M ${points.A.x + 40} ${points.A.y} A 40 40 0 0 1 ${points.A.x + 40
                                                * Math.cos(Math.PI/2 - alpha)} ${points.A.y - 40 * Math.sin(Math.PI/2 -
                                                alpha)}`} fill="none" stroke="#facc15" strokeWidth="2" opacity="0.6" />
                                            <text x={points.A.x + 55} y={points.A.y - 35} fill="#facc15" fontSize="12"
                                                fontWeight="bold">90°-α</text>

                                            {/* Beta Angle at A */}
                                            <path d={`M ${points.A.x + 60} ${points.A.y} A 60 60 0 0 1 ${points.A.x + 60
                                                * Math.cos(beta)} ${points.A.y - 60 * Math.sin(beta)}`} fill="none"
                                                stroke="#f472b6" strokeWidth="2" opacity="0.6" />
                                            <text x={points.A.x + 75} y={points.A.y - 10} fill="#f472b6" fontSize="14"
                                                fontWeight="bold">β</text>
                                        </g>
                                        )}

                                        {/* Proof Mode Specific Visuals */}
                                        {mode === 'proof' && proofStep >= 1 && (
                                        <line x1={points.B.x} y1={points.B.y} x2={E.x} y2={E.y} stroke="#a855f7"
                                            strokeWidth="2" strokeDasharray="4 4" />
                                        )}

                                        {mode === 'proof' && (proofStep === 2 || proofStep === 3) && (
                                        <>
                                            <polygon points={`${points.A.x},${points.A.y} ${points.B.x},${points.B.y}
                                                ${E.x},${E.y}`} fill="rgba(6, 182, 212, 0.2)" stroke="#06b6d4"
                                                strokeWidth="2" />
                                            <polygon points={`${points.D.x},${points.D.y} ${points.B.x},${points.B.y}
                                                ${points.C.x},${points.C.y}`} fill="rgba(6, 182, 212, 0.2)"
                                                stroke="#06b6d4" strokeWidth="2" />
                                        </>
                                        )}

                                        {mode === 'proof' && (proofStep === 4 || proofStep === 5) && (
                                        <>
                                            <polygon points={`${points.A.x},${points.A.y} ${points.B.x},${points.B.y}
                                                ${points.D.x},${points.D.y}`} fill="rgba(236, 72, 153, 0.2)"
                                                stroke="#ec4899" strokeWidth="2" />
                                            <polygon points={`${E.x},${E.y} ${points.B.x},${points.B.y}
                                                ${points.C.x},${points.C.y}`} fill="rgba(236, 72, 153, 0.2)"
                                                stroke="#ec4899" strokeWidth="2" />
                                        </>
                                        )}

                                        {mode === 'proof' && proofStep === 6 && (
                                        <>
                                            <line x1={points.A.x} y1={points.A.y} x2={points.C.x} y2={points.C.y}
                                                stroke="#10b981" strokeWidth="4" />
                                            <line x1={points.B.x} y1={points.B.y} x2={points.D.x} y2={points.D.y}
                                                stroke="#10b981" strokeWidth="4" />
                                        </>
                                        )}

                                        {mode === 'proof' && proofStep >= 1 && (
                                        <g transform={`translate(${E.x}, ${E.y})`}>
                                            <circle r="5" fill="#a855f7" stroke="#0f172a" strokeWidth="2" />
                                            <text x="10" y="5" fill="#a855f7" fontSize="14" fontWeight="bold">E</text>
                                        </g>
                                        )}

                                        {/* Interactive Points (Only render for circular modes) */}
                                        {mode !== 'rect-proof' && ['A', 'B', 'C', 'D'].map((pt) => {
                                        const isLocked =
                                        (mode === 'sine-sum' && (pt === 'A' || pt === 'C')) ||
                                        (mode === 'cosine-sum' && (pt === 'A' || pt === 'D'));

                                        return (
                                        <g key={pt} transform={`translate(${points[pt].x}, ${points[pt].y})`}
                                            onMouseDown={(e)=> !isLocked && handlePointerDown(e, pt)}
                                            onTouchStart={(e) => !isLocked && handlePointerDown(e, pt)}
                                            className={isLocked ? "cursor-not-allowed" : "cursor-grab
                                            active:cursor-grabbing"}
                                            style={{ touchAction: 'none' }}
                                            >
                                            {/* Invisible larger hit area for easier grabbing */}
                                            <circle r="25" fill="transparent" />
                                            <circle r="8" fill={isLocked ? "#64748b" : (activePoint===pt ? "#indigo-400"
                                                : "#cbd5e1" )} stroke="#0f172a" strokeWidth="3"
                                                className="transition-colors duration-200 hover:fill-white" />
                                            <text x="12" y="-12" fill="white" fontSize="16" fontWeight="bold"
                                                className="pointer-events-none select-none drop-shadow-md">
                                                {pt}
                                            </text>
                                        </g>
                                        );
                                        })}

                                        {/* RECTANGLE PROOF MODE VISUALS */}
                                        {mode === 'rect-proof' && (
                                        <g>
                                            {/* Bounding Rectangle */}
                                            <polygon points={`${V_bl.x},${V_bl.y} ${V_br.x},${V_br.y}
                                                ${V_tr.x},${V_tr.y} ${V_tl.x},${V_tl.y}`} fill="none" stroke="#475569"
                                                strokeWidth="2" strokeDasharray="4 4" />

                                            {/* Inner Right Triangles */}
                                            {/* Bottom Triangle (alpha) */}
                                            <polygon points={`${O.x},${O.y} ${V_br.x},${V_br.y} ${P2.x},${P2.y}`}
                                                fill="rgba(250, 204, 21, 0.1)" stroke="#facc15" strokeWidth="2"
                                                strokeLinejoin="round" />

                                            {/* Top Triangle (beta) */}
                                            <polygon points={`${O.x},${O.y} ${P2.x},${P2.y} ${P1.x},${P1.y}`}
                                                fill="rgba(96, 165, 250, 0.1)" stroke="#60a5fa" strokeWidth="2"
                                                strokeLinejoin="round" />

                                            {/* Right Angle Indicators */}
                                            <RightAngle p={V_br} p1={O} p2={V_tr} />
                                            <RightAngle p={V_tr} p1={V_br} p2={V_tl} />
                                            <RightAngle p={V_tl} p1={V_tr} p2={O} />
                                            <RightAngle p={O} p1={V_tl} p2={V_br} />
                                            <RightAngle p={P2} p1={V_br} p2={P1} /> {/* Right angle between inner
                                            triangles */}

                                            {/* Central Hypotenuse */}
                                            <line x1={O.x} y1={O.y} x2={P1.x} y2={P1.y} stroke="#cbd5e1"
                                                strokeWidth="3" />
                                            <LabelLine p1={O} p2={P1} text="1" color="#cbd5e1" offset={-20} />

                                            {/* Alpha/Beta Angle Arcs */}
                                            <path d={`M ${O.x + 50} ${O.y} A 50 50 0 0 1 ${O.x + 50 *
                                                Math.cos(alphaRad)} ${O.y - 50 * Math.sin(alphaRad)}`} fill="none"
                                                stroke="#facc15" strokeWidth="2" />
                                            <text x={O.x + 65} y={O.y - 15} fill="#facc15" fontSize="14"
                                                fontWeight="bold">α</text>

                                            <path d={`M ${O.x + 40 * Math.cos(alphaRad)} ${O.y - 40 *
                                                Math.sin(alphaRad)} A 40 40 0 0 1 ${O.x + 40 * Math.cos(alphaRad +
                                                betaRad)} ${O.y - 40 * Math.sin(alphaRad + betaRad)}`} fill="none"
                                                stroke="#60a5fa" strokeWidth="2" />
                                            <text x={O.x + 45} y={O.y - 35} fill="#60a5fa" fontSize="14"
                                                fontWeight="bold">β</text>

                                            {/* Triangle Side Labels */}
                                            {/* Bottom Triangle */}
                                            <LabelLine p1={O} p2={P2} text="cos(β)" color="#facc15" offset={15} />
                                            <LabelLine p1={P2} p2={P1} text="sin(β)" color="#60a5fa" offset={-25} />

                                            {/* Rectangle Edge Projections */}
                                            {/* Bottom Edge */}
                                            <LabelLine p1={O} p2={V_br} text="cos(α)cos(β)" color="#ffffff"
                                                offset={20} />

                                            {/* Right Edge (Split) */}
                                            <LabelLine p1={V_br} p2={{x: V_br.x, y: P2.y}} text="sin(α)cos(β)"
                                                color="#facc15" offset={-35} bg={false} />
                                            <LabelLine p1={{x: V_br.x, y: P2.y}} p2={V_tr} text="cos(α)sin(β)"
                                                color="#60a5fa" offset={-35} bg={false} />

                                            {/* Left Edge */}
                                            <LabelLine p1={O} p2={V_tl} text="sin(α+β)" color="#4ade80" offset={25} />

                                            {/* Top Edge (Split) */}
                                            <LabelLine p1={V_tl} p2={P1} text="cos(α+β)" color="#f472b6" offset={-20} />
                                            <LabelLine p1={P1} p2={V_tr} text="sin(α)sin(β)" color="#c084fc"
                                                offset={-20} />

                                            {/* Internal Construction Lines */}
                                            <line x1={P2.x} y1={P2.y} x2={V_br.x} y2={P2.y} stroke="#475569"
                                                strokeWidth="1" strokeDasharray="4 4" />
                                            <line x1={P1.x} y1={P1.y} x2={P1.x} y2={V_tr.y} stroke="#475569"
                                                strokeWidth="1" strokeDasharray="4 4" />

                                            {/* Main vertical divider showing the cosine subtraction */}
                                            <line x1={P1.x} y1={P1.y} x2={P1.x} y2={O.y} stroke="#3b82f6"
                                                strokeWidth="2" strokeDasharray="8 6" opacity="0.8" />
                                        </g>
                                        )}

                                    </svg>
                                </div>
                            </div>
                            );
                            };

                            export default App;